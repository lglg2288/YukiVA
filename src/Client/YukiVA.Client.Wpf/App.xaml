<Application x:Class="YukiVA.Client.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:YukiVA.Client.Wpf.Controls"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Плоская светлая палитра: поверхности, текст и роли (accent / success / danger). -->
        <SolidColorBrush x:Key="Page" Color="#F7F6F2" />
        <SolidColorBrush x:Key="Surface1" Color="#F1EFE8" />
        <SolidColorBrush x:Key="Surface2" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Border" Color="#E3E1DA" />
        <SolidColorBrush x:Key="TextPrimary" Color="#1F1E1C" />
        <SolidColorBrush x:Key="TextSecondary" Color="#5F5E5A" />
        <SolidColorBrush x:Key="TextMuted" Color="#9A9890" />
        <SolidColorBrush x:Key="AccentBg" Color="#E6F1FB" />
        <SolidColorBrush x:Key="AccentText" Color="#0C447C" />
        <SolidColorBrush x:Key="SuccessBg" Color="#EAF3DE" />
        <SolidColorBrush x:Key="SuccessText" Color="#3B6D11" />
        <SolidColorBrush x:Key="DangerBg" Color="#FCEBEB" />
        <SolidColorBrush x:Key="DangerText" Color="#A32D2D" />
        <SolidColorBrush x:Key="Highlight" Color="#FAE3B4" />
        <SolidColorBrush x:Key="Bar" Color="#378ADD" />
        <c:StageMatchesConverter x:Key="StageMatches" />
    </Application.Resources>
</Application>
