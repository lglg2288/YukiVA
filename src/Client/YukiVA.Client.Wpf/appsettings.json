{
  "Api": {
    "BaseUrl": "http://localhost:5000",
    "Key": "",
    "HeaderName": "X-Api-Key"
  },
  "Mcp": {
    "Name": "erp",
    "Command": "docker",
    "Arguments": [
      "run", "-i", "--rm",
      "-e", "DATABASE_URI=postgresql://erp_reader:erp_reader_password@host.docker.internal:5433/erp",
      "crystaldba/postgres-mcp",
      "--access-mode=restricted"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
