<Window x:Class="YukiVA.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:YukiVA.Client.Wpf.ViewModels"
        xmlns:c="clr-namespace:YukiVA.Client.Wpf.Controls"
        Title="Yuki harness" Width="1040" Height="700" MinWidth="760" MinHeight="480"
        Background="{StaticResource Page}" FontFamily="Segoe UI" FontSize="14"
        Foreground="{StaticResource TextPrimary}">

    <Window.Resources>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="{StaticResource Surface1}" />
        </Style>

        <!-- Чип этапа: подсвечен, когда Stage совпадает с Tag. -->
        <Style x:Key="StageChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextMuted}" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource StageMatches}">
                            <Binding Path="DataContext.Stage" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource AccentBg}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource AccentText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:UserMessageViewModel}">
            <Border HorizontalAlignment="Right" MaxWidth="460" Margin="60,6,0,6" Padding="12,8"
                    CornerRadius="12" Background="{StaticResource AccentBg}">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource AccentText}" />
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AssistantMessageViewModel}">
            <Border HorizontalAlignment="Left" MaxWidth="520" Margin="0,6,60,6" Padding="12,8"
                    CornerRadius="12" Background="{StaticResource Surface1}">
                <TextBlock TextWrapping="Wrap"
                           c:HighlightedText.Brush="{StaticResource Highlight}"
                           c:HighlightedText.Text="{Binding Text}"
                           c:HighlightedText.Start="{Binding HighlightStart}"
                           c:HighlightedText.Length="{Binding HighlightLength}" />
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ErrorMessageViewModel}">
            <Border HorizontalAlignment="Left" MaxWidth="520" Margin="0,6,60,6" Padding="12,8"
                    CornerRadius="12" Background="{StaticResource DangerBg}">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource DangerText}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ToolCallCard" DataType="{x:Type vm:ToolCallViewModel}">
            <Border Margin="0,0,6,0" Padding="10,8" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{StaticResource Border}" Background="{StaticResource Surface2}" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandedCommand}" />
                </Border.InputBindings>
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" FontSize="12" Text="{Binding Duration}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                            <Setter Property="Text" Value="выполняется…" />
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                            <Setter Property="Foreground" Value="{StaticResource DangerText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="13" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" Text="{Binding Arguments}" FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" MaxHeight="34"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding ResultPreview}" FontSize="12"
                               Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                    <TextBox Margin="0,6,0,0" Text="{Binding Result, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" MaxHeight="220"
                             VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="{StaticResource Surface1}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ToolCallGroupViewModel}">
            <ItemsControl Margin="0,6,60,6" ItemsSource="{Binding Calls}" ItemTemplate="{StaticResource ToolCallCard}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Шапка -->
        <Border Grid.ColumnSpan="2" Padding="16,10" Background="{StaticResource Surface2}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                <Setter Property="Background" Value="{StaticResource DangerBg}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource DangerText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ToolsReady}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessBg}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ToolsStatus}" FontSize="12" />
                    </Border>
                    <Button Margin="10,0,0,0" Content="Новый диалог" Focusable="False" Cursor="Hand"
                            Command="{Binding NewConversationCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Chrome" Padding="10,3" CornerRadius="6" BorderThickness="1"
                                        BorderBrush="{StaticResource Border}" Background="{StaticResource Surface2}">
                                    <ContentPresenter TextElement.FontSize="12" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface1}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <TextBlock Text="Yuki harness" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Лента -->
        <ScrollViewer x:Name="ChatScroll" Grid.Row="1" Padding="16,8" VerticalScrollBarVisibility="Auto"
                      ScrollChanged="OnChatScrollChanged" Focusable="False">
            <Grid>
                <ItemsControl ItemsSource="{Binding Items}" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,160,0,0"
                           Foreground="{StaticResource TextMuted}" TextAlignment="Center" FontSize="15"
                           Text="Зажмите пробел и задайте вопрос&#x0a;например: «Сколько заказов было на прошлой неделе?»">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </ScrollViewer>

        <!-- Latency -->
        <Border Grid.Row="1" Grid.Column="1" Padding="14,12" Background="{StaticResource Surface2}"
                BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
            <DockPanel DataContext="{Binding Latency}">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondary}">
                        <Run Text="Latency · ход" /> <Run Text="{Binding Turn, Mode=OneWay}" />
                    </TextBlock>
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Bars}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LatencyBarViewModel}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="12" />
                                    <Canvas Grid.Column="1" Height="10" Background="{StaticResource Surface1}">
                                        <Rectangle Canvas.Left="{Binding Left}" Width="{Binding Width}" Height="10"
                                                   RadiusX="2" RadiusY="2" Fill="{StaticResource Bar}" />
                                    </Canvas>
                                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12" TextAlignment="Right"
                                               Foreground="{StaticResource TextSecondary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextMuted}"
                               Text="мс от конца речи" />
                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource TextMuted}" Text="{Binding Tools}" />
                    <Border Margin="0,10,0,8" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" />
                </StackPanel>
                <ListBox x:Name="LatencyLog" ItemsSource="{Binding Log}" BorderThickness="0" Background="Transparent"
                         FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextSecondary}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False" />
            </DockPanel>
        </Border>

        <!-- Push-to-talk -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="16,10" Background="{StaticResource Surface2}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Border x:Name="MicButton" Width="42" Height="42" CornerRadius="21" Cursor="Hand"
                        MouseLeftButtonDown="OnMicDown" MouseLeftButtonUp="OnMicUp">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Surface1}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Stage}" Value="Listening">
                                    <Setter Property="Background" Value="{StaticResource DangerBg}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Style="{StaticResource StageChip}" Tag="Listening"><TextBlock Text="Слушаю" FontSize="12" /></Border>
                    <Border Style="{StaticResource StageChip}" Tag="Recognizing"><TextBlock Text="Распознаю" FontSize="12" /></Border>
                    <Border Style="{StaticResource StageChip}" Tag="Thinking"><TextBlock Text="Думаю" FontSize="12" /></Border>
                    <Border Style="{StaticResource StageChip}" Tag="Speaking"><TextBlock Text="Говорю" FontSize="12" /></Border>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           Text="Удерживайте пробел, чтобы говорить · Esc — перебить" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
