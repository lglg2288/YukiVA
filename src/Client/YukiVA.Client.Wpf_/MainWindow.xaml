<Window x:Class="YukiVA.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:YukiVA.Client.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="YukiVA — голосовой клиент" Height="620" Width="520"
        Background="#1E1E1E">

    <Window.Resources>
        <!-- bool -> Visibility (для индикатора загрузки) -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>      <!-- переписка -->
            <RowDefinition Height="Auto"/>   <!-- индикатор загрузки -->
            <RowDefinition Height="Auto"/>   <!-- статус -->
            <RowDefinition Height="Auto"/>   <!-- кнопка записи -->
        </Grid.RowDefinitions>

        <!-- ===== История переписки ===== -->
        <ListBox Grid.Row="0"
                 ItemsSource="{Binding Messages}"
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Focusable" Value="False"/>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- "Пузырь" сообщения. Слева — ассистент, справа — пользователь. -->
                    <Border x:Name="Bubble" CornerRadius="12" Padding="11,8" Margin="0,4"
                            MaxWidth="380" HorizontalAlignment="Left" Background="#2D2D30">
                        <StackPanel>
                            <TextBlock Text="{Binding Role}" FontSize="11"
                                       Foreground="#9CDCFE" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding Text}" Foreground="White"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <DataTemplate.Triggers>
                        <!-- Если это сообщение пользователя — двигаем вправо и красим иначе. -->
                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                            <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Bubble" Property="Background" Value="#0E639C"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ===== Индикатор сетевого запроса ===== -->
        <ProgressBar Grid.Row="1" Height="3" Margin="0,8,0,0" IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

        <!-- ===== Строка статуса ===== -->
        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="#CCCCCC"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8"/>

        <!-- ===== Кнопка записи ===== -->
        <Border Grid.Row="3" CornerRadius="22" Width="190" Height="46"
                HorizontalAlignment="Center" Margin="0,4,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#A11E1E"/>   <!-- красный: готов записывать -->
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                            <Setter Property="Background" Value="#1A7F37"/> <!-- зелёный: идёт запись -->
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Button Content="{Binding RecordButtonText}"
                    Command="{Binding ToggleRecordCommand}"
                    Background="Transparent" BorderThickness="0"
                    Foreground="White" FontSize="17" Cursor="Hand"/>
        </Border>
    </Grid>
</Window>
